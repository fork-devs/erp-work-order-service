# ==============================================================================
# ERP WORK ORDER SERVICE - ENVIRONMENT CONFIGURATION
# ==============================================================================
#
# Este fichero declara los NOMBRES de las variables, nunca sus valores. Ningun
# secreto (contrasenas, claves de servicio) se escribe aqui: se resuelve por
# variable de entorno o por el almacen de secretos.
# ==============================================================================

# Server configuration (la ruta del gateway work-order-service apunta aqui)
SERVER_PORT=8088

# Database configuration (PostgreSQL erp_work_order_db)
#
# SPRING_DATASOURCE_USERNAME es el rol de EJECUCION: no es propietario de las
# tablas, porque el propietario elude su propia politica de Row-Level Security.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5437/erp_work_order_db
SPRING_DATASOURCE_USERNAME=erp_work_order_app
SPRING_DATASOURCE_PASSWORD=

# Rol PROPIETARIO: lo usa unicamente Flyway para las migraciones.
SPRING_FLYWAY_USER=erp_work_order_owner
SPRING_FLYWAY_PASSWORD=

# Rol de EJECUCION de la aplicacion, que crea la migracion V1.
ERP_APP_DB_PASSWORD=

# Auth service JWKS URL
#
# El conjunto de claves se publica en /.well-known/jwks.json. Debe usar https
# fuera del perfil de desarrollo local.
JWKS_URL=https://auth.erp-automotriz.com/.well-known/jwks.json

# Saga: servicios con los que la orden llama
INVENTORY_SERVICE_URL=http://localhost:8084
FLEET_SERVICE_URL=http://localhost:8083

# OpenAPI (solo en ambiente de desarrollo; en prod se desactiva)
SWAGGER_ENABLED=false
